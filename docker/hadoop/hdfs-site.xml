<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
  <!-- 单机仿真副本数 = 2（设计报告 2.1.3 / D-8） -->
  <property>
    <name>dfs.replication</name>
    <value>2</value>
  </property>

  <!-- 元数据与数据目录挂载到命名卷，容器重建不丢数据 -->
  <property>
    <name>dfs.namenode.name.dir</name>
    <value>/data/name</value>
  </property>
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>/data/data</value>
  </property>

  <!-- WebHDFS 访问（设计报告 5.2.3：以 REST 替代 hadoop-client） -->
  <property>
    <name>dfs.webhdfs.enabled</name>
    <value>true</value>
  </property>

  <!-- 仿真环境关闭权限检查，规避 HDFS 权限坑（设计报告 5.3 P-…） -->
  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>
</configuration>
