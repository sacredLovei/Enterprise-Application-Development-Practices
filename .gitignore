# ---- 治理与备份 ----
_backups/

# ---- 本地工具（JDK 等不入库；md2html 转换链入库，保证报告构建可复现） ----
tools/*
!tools/md2html/

# ---- Office 临时锁文件 ----
~$*

# ---- Java / Maven ----
target/
*.class

# ---- Node / 前端 ----
node_modules/
dist/

# ---- 日志与临时文件 ----
*.log
.DS_Store
Thumbs.db

# ---- 压测产物（体积大，仅本地留存；汇总数据回填报告/STATE） ----
test/jmeter/*.jtl
test/jmeter/report-*/

# ---- ES 插件二进制（ik，由 install-ik.ps1 安装，不入库） ----
docker/es-plugins/
