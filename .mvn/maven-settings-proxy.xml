<?xml version="1.0" encoding="UTF-8"?>
<!-- 本机 Maven 构建专用 settings（D-17 / 风险 #17）：
     1) 经 Clash 混合端口访问 Maven Central；
     2) 本地仓库重定向到工作区 tools\m2repo（沙箱禁止写 ~/.m2，且 tools/ 已 gitignore）。
     用法：mvn -s .mvn/maven-settings-proxy.xml -DskipTests package -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <localRepository>C:\Users\黎Li\Desktop\Enterprise Application Development Practices\tools\m2repo</localRepository>
  <proxies>
    <proxy>
      <id>clash-local</id>
      <active>true</active>
      <protocol>http</protocol>
      <host>127.0.0.1</host>
      <port>7897</port>
      <nonProxyHosts>localhost|127.0.0.1</nonProxyHosts>
    </proxy>
  </proxies>
</settings>
